{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020"
    ],
    "outDir": "./dist",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/backend/**/*",
    "src/types/**/*",
    "src/constants/**/*",
    "components/**/*"
  ],
  "exclude": [
    "node_modules",
    "SafeTruck3",
    "**/__tests__/**",
    "src/services/**/*"
  ],
  "extends": "expo/tsconfig.base"
}
