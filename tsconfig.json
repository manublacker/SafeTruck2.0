{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/backend/**/*",
    "src/types/**/*",
    "src/constants/**/*"
  ],
  "exclude": [
    "node_modules",
    "SafeTruck3",
    "**/__tests__/**",
    "src/services/**/*"
  ]
}